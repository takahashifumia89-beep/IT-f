{
  "name": "it-forum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "db:init:local": "wrangler d1 execute it-forum-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute it-forum-db --remote --file=schema.sql",
    "gen-secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('base64url'))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.14",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sonner": "2.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250910.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.6.0",
    "vite": "6.3.5",
    "wrangler": "^4.0.0"
  }
}
